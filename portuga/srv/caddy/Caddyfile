{
	email "rescobar@pm.me"
	storage file_system {
		root /var/lib/caddy/data
	}
	log {
		output file /var/log/caddy/caddy.log {
			roll_uncompressed
			roll_keep 100
		}
	}
}

(base) {
	root * /var/lib/caddy/content/{host}
	try_files {path} {path}.html
	encode zstd gzip
	header {
		Referrer-Policy origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options deny
	}
}

www.paemuri.com, www.kapiyeya.com, www.classicos.info {
	redir https://{labels.1}.{labels.0}{uri}
}

classicos.info {
	import base
	file_server
}

paemuri.com {
	import base
	file_server {
		hide error.html
	}
	handle_errors {
		rewrite * /error.html
	}
}

kapiyeya.com {
	import base
	file_server
	handle_errors {
		rewrite * /{err.status_code}
		reverse_proxy https://http.cat {
			header_up Host {upstream_hostport}
		}
	}
}
