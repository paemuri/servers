{
	email "rescobar@pm.me"
	storage file_system {
		root /var/lib/caddy/data
	}
	log {
		output file /var/log/caddy/caddy.log {
			roll_uncompressed
			roll_keep 100
		}
	}
}

(base) {
	root * /var/lib/caddy/content/{host}
	try_files {path} {path}.html
	encode zstd gzip
	header {
		Referrer-Policy origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options deny
	}
}

www.paemuri.com, www.kapiyeya.com, www.classicos.info {
	redir https://{labels.1}.{labels.0}{uri}
}

classicos.info {
	import base
	file_server
}

paemuri.com {
	import base
	file_server {
		hide error.html
	}
	handle_errors {
		rewrite * /error.html
		file_server
	}
	header {
		Content-Security-Policy "default-src 'self'; style-src 'self' https://code.cdn.mozilla.net; font-src https://code.cdn.mozilla.net; img-src 'self'; script-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
	@static path /static/*
	header @static Cache-Control "public, max-age=86400"
}

kapiyeya.com {
	import base
	file_server
	handle_errors {
		rewrite * /{err.status_code}
		reverse_proxy https://http.cat {
			header_up Host {upstream_hostport}
			replace_status {err.status_code}
		}
	}
	@assets path /images/* /stylesheets/* /scripts/* /lib/*
	header @assets Cache-Control "public, max-age=86400"
}
