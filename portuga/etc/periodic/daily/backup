#!/bin/sh

source /etc/profile
backups_dir=/var/local/backups
backup=$SERVER_NAME.bkp-$(date +%F)

mkdir -p $backups_dir/$backup
cd $backups_dir

for ps in $SERVER_PROCESSES
do
  mkdir -p $backup/var/lib/$ps
  cp -rp /var/lib/$ps/* $backup/var/lib/$ps
done

tar -cvp \
  --zstd \
  --file=$backup.tar.zst \
  $backup
rm -rf $backup

# Clean backups older than 30 days.
find . \
  -type f \
  -mtime +30 \
  -exec rm -rf {} \;

rclone sync . mega-crypt:/server-backups/$SERVER_NAME
