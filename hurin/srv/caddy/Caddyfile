{
	email "f@ily-biason.de"
	storage file_system {
		root /var/lib/caddy/data
	}
	log {
		output file /var/log/caddy/caddy.log {
			roll_uncompressed
			roll_keep 100
		}
	}
}

www.ily-biason.de {
	redir https://{labels.1}.{labels.0}{uri}
}

ily-biason.de {
	root * /var/lib/caddy/content/{host}
	try_files {path} {path}.html
	encode zstd gzip

	file_server

	header /.well-known/matrix/* Content-Type application/json
	header /.well-known/matrix/* Access-Control-Allow-Origin *
	respond /.well-known/matrix/server `{"m.server":"matrix.ily-biason.de"}`
	respond /.well-known/matrix/client `{"m.homeserver":{"base_url":"https://matrix.ily-biason.de"}}`
}

matrix.ily-biason.de matrix.ily-biason.de:8448 matrix.ily-biason.de:8008 {
	reverse_proxy * http://dendrite:8008
}
