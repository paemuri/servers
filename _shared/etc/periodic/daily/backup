#!/bin/sh

source /etc/profile

[ -z "$BACKUP_SERVICES" ] && exit 0

backups_dir=/var/local/backups
backup=$SERVER_NAME.bkp-$(date +%F)

mkdir -p $backups_dir/$backup
cd $backups_dir # cd so archived files have sane paths.

for svc in $BACKUP_SERVICES
do
  mkdir -p $backup/var/lib/$svc
  cp -rp /var/lib/$svc/* $backup/var/lib/$svc
done

tar -cvp \
  --zstd \
  --file=$backup.tar.zst \
  $backup
rm -rf $backup

# Clean backups older than 30 days.
find . \
  -type f \
  -mtime +30 \
  -exec rm -rf {} \;

rclone sync . mega-crypt:/server-backups/$SERVER_NAME
